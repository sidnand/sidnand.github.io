@inproceedings{10.1145/3649217.3653540,
    author = {Zarkoob, Hedayat and Nand, Siddharth and Leyton-Brown, Kevin and Toti, Giulia},
    title = {Agora: Motivating and Measuring Engagement in Large-Class Discussions},
    year = {2024},
    publisher = {Association for Computing Machinery},
    address = {New York, NY, USA},
    abstract = {Cold calling effectively incentivizes all students to actively prepare contributions to a class discussion, but some find it terrifying. Rewarding voluntarily speaking in class is less off-putting, and can be valuable for students who participate; however, it can allow a large fraction of the class to disengage. Agora is an open-source app designed to serve as a middle ground between these extremes, with the added benefit that it automatically produces an assessment of each student's engagement. The key ideas are to give students control over whether their hand is raised or lowered, to choose randomly among students with raised hands, and to give participation credit to all students who were considered every time a speaker is chosen. The system has various other features to facilitate deployment in large classes including multiple queues to support concurrent questions on different topics; a message board to allow students to communicate discretely with the instructor; and polling. We deployed the system in three offerings of a large undergraduate class and demonstrate its effectiveness in terms of learning outcomes, gender balance in participation, and student satisfaction.},
    booktitle = {Proceedings of the 2024 on Innovation and Technology in Computer Science Education V. 1},
    pages = {729-735},
    numpages = {7},
    keywords = {educational technology, in-class participation},
    location = {Milan, Italy},
    series = {ITiCSE 2024},
    doi = {10.1145/3649217.3653540},
    pdf = {publications/agora_zarkoob_2024.pdf},
    bibtex_show = {false}
}

@article{gabriella2025arithmetic_error_budgets,
    author = {Gabriella, Ziya ad-Din and Nand, Siddharth},
    title = {Arithmetic Error Budgets in Bayesian Metropolis--Hastings},
    journal = {Journal of Machine Learning Research},
    year = {2025},
    abstract = {If a Bayesian log density is evaluated by the same deterministic routine at every state, its arithmetic error is a potential: the Metropolis--Hastings chain is exact for a tilted posterior. We quantify that tilt in total variation and propagate a standard summation error bound through it, keeping term-evaluation and accumulator precision separate. A closed-form Gaussian example gives the local u_n sqrt(n) displacement scale, while a bounded-parameter likelihood example shows which assumptions make a global budget finite. Neither scale is universal: both depend on the numerical pipeline and on uniform control of the likelihood terms.},
    doi = {10.5281/zenodo.24451645},
    pdf = {publications/gabriella_2025.pdf},
    bibtex_show = {false}
}

@article{ougein2025finite_run_certification,
    author = {Ougein, Antonino and Nand, Siddharth and Gabriella, Ziya ad-Din},
    title = {Finite-Run Certification for Approximate Metropolis--Hastings: Bounds and Limits},
    journal = {Proceedings of Machine Learning Research},
    year = {2025},
    abstract = {When can a finite Metropolis--Hastings run be certified as close to its target? Under a known Wasserstein contraction and an analytic one-step error bound, we give a law-level guarantee for every run horizon. A common-proposal coupling converts acceptance error into the one-step term, and a potential--residual split separates transient error from stationary target shift. Conversely, two irreducible two-state chains can have almost indistinguishable short paths but well-separated invariant laws. The certificate is therefore useful only when its structural constants are known independently of the observed trajectory.},
    doi = {10.5281/zenodo.24451769},
    pdf = {publications/ougein_2025.pdf},
    bibtex_show = {false}
}

@article{nand2024cycle_structure,
    author = {Nand, Siddharth and Athelstan, Ortwin},
    title = {Cycle Structure and Stationary Bias in Perturbed Metropolis--Hastings Kernels},
    journal = {Journal of Machine Learning Research},
    volume = {25},
    year = {2024},
    abstract = {The same numerical error in a Metropolis--Hastings (MH) log ratio can either change the target or create probability currents. On a finite reciprocal proposal graph, the distinction is exact: an antisymmetric error is a target tilt if and only if its sum around every cycle is zero. We use this criterion to separate a state potential from a cycle residual. Under a Dobrushin contraction assumption, the stationary-law error is bounded by the sharp total-variation effect of the tilt plus a residual term measured at the acceptance-probability level. A three-state cycle shows why nonzero circulation need not alter the stationary marginal, even though it destroys reversibility. A two-state MH construction attains the inverse-contraction dependence in the residual term.},
    doi = {10.5281/zenodo.24451711},
    pdf = {publications/nand_2024.pdf},
    bibtex_show = {false}
}
